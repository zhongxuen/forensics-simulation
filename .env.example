# Copy to .env.local for local development. The app works fully with every value left empty.

# The Claude API key for the optional mentor routes (docs/plan/14-mentor.md). Empty means every
# hint is the authored text. Server-only: never prefix it with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Set to 1 to turn the mentor's model calls off (the kill switch). Hints fall back to the authored text.
MENTOR_DISABLED=

# Overrides the mentor's model. Defaults to claude-haiku-4-5.
MENTOR_MODEL=
